"""Local credential / path resolution.

Copy this file to ``src/utils/secret.py`` and export the environment variables
you need before running anything:

    cp src/utils/secret.py.example src/utils/secret.py

    export HF_TOKEN=...          # gated model downloads (Gemma, Llama)
    export OPENAI_API_KEY=...    # LLM-as-a-judge winrate evaluation
    export WANDB_API_KEY=...     # optional, only for online W&B logging

``src/utils/secret.py`` is git-ignored on purpose: never hardcode a credential
in it, and never commit it.
"""

from __future__ import annotations

import os
from pathlib import Path

SOURCE_ROOT = Path(__file__).resolve().parents[1]
PROJECT_ROOT = SOURCE_ROOT.parent

# Keep the historical string names for the rest of the codebase.
Source_dir = str(SOURCE_ROOT)
Project_dir = str(PROJECT_ROOT)

wandbkey = os.getenv("WANDB_API_KEY", "")
HF_token = os.getenv("HF_TOKEN", os.getenv("HUGGINGFACE_HUB_TOKEN", ""))
github_token = os.getenv("GITHUB_TOKEN", "")
openai_api_key = os.getenv("OPENAI_API_KEY", os.getenv("API_KEY", ""))
openai_api_base = os.getenv("OPENAI_API_BASE", "")
